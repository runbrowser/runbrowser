{
  "name": "runbrowser-root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter mcp-extension build",
    "build:extension": "pnpm --filter mcp-extension build",
    "dev:extension": "pnpm --filter mcp-extension dev",
    "typecheck": "pnpm --filter runbrowser typecheck",
    "test": "pnpm --filter runbrowser test",
    "publish:all": "pnpm --filter runbrowser publish --no-git-checks"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "3.15.1"
    }
  }
}

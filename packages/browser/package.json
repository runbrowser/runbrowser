{
  "name": "@termio/browser",
  "version": "0.1.0",
  "description": "Control your running Chrome browser over CDP \u2014 your logins, extensions and cookies already there",
  "type": "module",
  "exports": {
    ".": "./src/server/index.ts",
    "./client": "./src/server/client.ts",
    "./api": "./src/server/api-client.ts",
    "./types": "./src/server/cdp-types.ts",
    "./protocol": "./src/server/protocol.ts",
    "./utils": "./src/server/utils.ts",
    "./logger": "./src/server/create-logger.ts",
    "./start": "./src/server/start.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "termio-browser": "./bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "files": [
    "bin.js"
  ],
  "keywords": [
    "runbrowser",
    "browser",
    "automation",
    "chrome",
    "cdp",
    "chrome-devtools-protocol",
    "mcp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termio-sh/browser.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/termio-sh/browser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "devtools-protocol": "^0.0.1568893",
    "picocolors": "^1.1.1",
    "strip-ansi": "^7.1.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.5",
    "zustand": "^5.0.8"
  },
  "optionalDependencies": {
    "@termio/browser-darwin-arm64": "0.1.0",
    "@termio/browser-darwin-x64": "0.1.0",
    "@termio/browser-linux-x64": "0.1.0",
    "@termio/browser-linux-arm64": "0.1.0",
    "@termio/browser-win32-x64": "0.1.0"
  }
}

{
  "name": "@termio/browser",
  "version": "0.1.0",
  "description": "Control your running Chrome browser via Playwright — your logins, extensions, cookies already there",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "termio-browser": "./bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "bin.js"
  ],
  "keywords": [
    "runbrowser",
    "browser",
    "automation",
    "chrome",
    "playwright",
    "cdp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runbrowser/runbrowser.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/runbrowser/runbrowser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@termio/browser-server": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@jiweiyuan/runbrowser",
  "version": "0.0.8",
  "description": "Control your running Chrome browser via Playwright — your logins, extensions, cookies already there",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "runbrowser": "./bin.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src",
    "bin.js"
  ],
  "keywords": [
    "runbrowser",
    "browser",
    "automation",
    "chrome",
    "playwright",
    "cdp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runbrowser/runbrowser.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/runbrowser/runbrowser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@jiweiyuan/runbrowser-server": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}

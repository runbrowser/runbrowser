{
  "name": "@jiweiyuan/runbrowser-server",
  "version": "0.0.6",
  "description": "RunBrowser server — bridges Chrome extension WebSocket to CDP clients",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./api": {
      "types": "./dist/api-client.d.ts",
      "import": "./dist/api-client.js"
    },
    "./types": {
      "types": "./dist/cdp-types.d.ts",
      "import": "./dist/cdp-types.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./logger": {
      "types": "./dist/create-logger.d.ts",
      "import": "./dist/create-logger.js"
    },
    "./start": {
      "types": "./dist/start.d.ts",
      "import": "./dist/start.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "runbrowser-server": "./bin.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -u",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src",
    "bin.js"
  ],
  "keywords": [
    "cdp",
    "chrome-devtools-protocol",
    "relay",
    "websocket",
    "playwright",
    "browser",
    "runbrowser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runbrowser/runbrowser.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/runbrowser/runbrowser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/node-ws": "^1.2.0",
    "hono": "^4.10.6",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "strip-ansi": "^7.1.2",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "devtools-protocol": "^0.0.1568893",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}

{
  "name": "@termio/browser-server",
  "version": "0.1.0",
  "description": "RunBrowser server — bridges Chrome extension WebSocket to CDP clients",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./api": "./src/api-client.ts",
    "./types": "./src/cdp-types.ts",
    "./protocol": "./src/protocol.ts",
    "./utils": "./src/utils.ts",
    "./logger": "./src/create-logger.ts",
    "./start": "./src/start.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "runbrowser-server": "./bin.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run -u",
    "test:watch": "vitest"
  },
  "files": [
    "src",
    "bin.js"
  ],
  "keywords": [
    "cdp",
    "chrome-devtools-protocol",
    "relay",
    "websocket",
    "playwright",
    "browser",
    "runbrowser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runbrowser/runbrowser.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/runbrowser/runbrowser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "strip-ansi": "^7.1.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "devtools-protocol": "^0.0.1568893",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}

{
  "name": "@agmod/runbrowser-core",
  "version": "0.0.2",
  "description": "Shared core library for RunBrowser — debugger, editor, ffmpeg, diff, and browser utilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ffmpeg": {
      "types": "./dist/ffmpeg.d.ts",
      "import": "./dist/ffmpeg.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -u",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "runbrowser",
    "playwright",
    "browser",
    "automation",
    "chrome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanjiwei/runbrowser.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yuanjiwei/runbrowser",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@agmod/runbrowser-relay": "workspace:*",
    "diff": "^8.0.2",
    "posthtml": "^0.16.7",
    "posthtml-beautify": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "devtools-protocol": "^0.0.1568893",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
